<Project Sdk="Microsoft.NET.Sdk">

  <!-- Tüm Grapekit uygulamalarının ortak çekirdeği: marka, tema, kontroller, güncelleme, standart menü -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>Grapekit</RootNamespace>
    <AssemblyName>Grapekit.Core</AssemblyName>
  </PropertyGroup>

  <!-- Marka yazı tipleri (SIL Open Font License; lisanslar Fonts klasöründe) -->
  <ItemGroup>
    <EmbeddedResource Include="Fonts\*.ttf" LogicalName="Grapekit.Fonts.%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
