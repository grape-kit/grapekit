<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>brand\app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>MarkdownEditor</AssemblyName>
    <RootNamespace>MarkdownEditor</RootNamespace>

    <Product>Markdown Editörü</Product>
    <AssemblyTitle>Markdown Editörü</AssemblyTitle>
    <Version>1.0.0</Version>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Grapekit.Core\Grapekit.Core.csproj" />
    <Using Include="Grapekit" />
    <Using Include="Grapekit.Ui" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="packaging\**;dist\**;web\**" />
    <Compile Remove="packaging\**;dist\**;web\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
  </ItemGroup>

  <!-- Arayüz (web\wwwroot) çıktının yanına wwwroot olarak kopyalanır. tools\build-app.ps1 arayüzü önceden derler. -->
  <PropertyGroup>
    <WebReady Condition="Exists('web\wwwroot\app.js')">true</WebReady>
  </PropertyGroup>
  <ItemGroup Condition="'$(WebReady)' == 'true'">
    <Content Include="web\wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>

  <!-- Temiz kopyada doğrudan derlenirse: önce npm ile arayüzü üret, sonra öğeleri ekle. SkipWeb=true ile atlanır. -->
  <Target Name="BuildWeb" BeforeTargets="AssignTargetPaths" Condition="'$(SkipWeb)' != 'true' And '$(WebReady)' != 'true'">
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="web" Condition="!Exists('web\node_modules')" />
    <Exec Command="npm run build" WorkingDirectory="web" />
    <ItemGroup>
      <Content Include="web\wwwroot\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Link="wwwroot\%(RecursiveDir)%(Filename)%(Extension)" />
    </ItemGroup>
  </Target>

  <!-- Kurulumu küçült: WinForms kullanıldığı için WPF kütüphanesi ve belge XML'leri gerekmez -->
  <Target Name="TrimPublish" AfterTargets="Publish">
    <Delete Files="$(PublishDir)Microsoft.Web.WebView2.Wpf.dll;$(PublishDir)Microsoft.Web.WebView2.Wpf.xml;$(PublishDir)Microsoft.Web.WebView2.Core.xml;$(PublishDir)Microsoft.Web.WebView2.WinForms.xml" />
  </Target>

</Project>
