<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifiers>win-x64;win-x86;win-arm64</RuntimeIdentifiers>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- Dosya ve ayar klasörü adı eski sürümlerle uyumlu kalır -->
    <AssemblyName>CapsGosterge</AssemblyName>
    <RootNamespace>CapsGosterge</RootNamespace>

    <Product>Caps Lock Göstergesi</Product>
    <AssemblyTitle>Caps Lock Göstergesi</AssemblyTitle>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Grapekit.Core\Grapekit.Core.csproj" />
    <Using Include="Grapekit" />
    <Using Include="Grapekit.Ui" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="packaging\**;dist\**" />
    <Compile Remove="packaging\**;dist\**" />
  </ItemGroup>

</Project>
